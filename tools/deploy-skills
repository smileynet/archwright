#!/usr/bin/env bash
# Deploy archwright skills and steering from repo to global ~/.kiro/
# Run from the archwright repo root.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SKILLS_SRC="$REPO_DIR/skills"
STEERING_SRC="$REPO_DIR/steering"
SKILLS_DST="$HOME/.kiro/skills"
STEERING_DST="$HOME/.kiro/steering"

# Deploy skills
if [ -d "$SKILLS_SRC" ]; then
  for skill_dir in "$SKILLS_SRC"/archwright-*/; do
    [ -d "$skill_dir" ] || continue
    name=$(basename "$skill_dir")
    rm -rf "$SKILLS_DST/$name"
    cp -r "$skill_dir" "$SKILLS_DST/$name"
    echo "  ✓ $name"
  done
fi

# Deploy steering
if [ -d "$STEERING_SRC" ]; then
  for file in "$STEERING_SRC"/*.md; do
    [ -f "$file" ] || continue
    name=$(basename "$file")
    cp "$file" "$STEERING_DST/$name"
    echo "  ✓ $name"
  done
fi

echo ""
echo "Deployed from $REPO_DIR to ~/.kiro/"
